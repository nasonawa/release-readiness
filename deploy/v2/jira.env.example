# Copy outside the repository, fill values, then create the Secret using --from-env-file.
JIRA_URL=https://redhat.atlassian.net
JIRA_API_URL=https://redhat.atlassian.net
JIRA_PROJECT=PROJQUAY
JIRA_EMAIL=YOUR_JIRA_EMAIL
JIRA_TOKEN=YOUR_READ_API_TOKEN
# For scoped Atlassian tokens, replace JIRA_API_URL with:
# https://api.atlassian.com/ex/jira/YOUR_CLOUD_ID
