# Copy to deploy/.env. Parsed as data, not shell: no variable expansion.
# Replace your-namespace with the target OpenShift project.
NAMESPACE=your-namespace
# Replace your-org with your registry organization; build and publish the image first.
IMAGE=quay.io/your-org/release-readiness:v2.2
# Optional: blank lets OpenShift choose the route and default storage class.
ROUTE_HOST=
# For the existing production claim use STORAGE_CLASS=aws-efs-tier-c4 and
# STORAGE_SIZE=1Gi: a bound PVC rejects both a class change and most resizes.
STORAGE_CLASS=
STORAGE_SIZE=5Gi
# Self-contained, minified KONFLUX reader kubeconfig, not the OCP target config.
# Relative paths are resolved against this .env file.
KONFLUX_KUBECONFIG=
# Optional Docker/Podman auth JSON for a private image repository.
IMAGE_PULL_SECRET_FILE=

JIRA_EMAIL=
# Required read tokens, supplied inline. GITHUB_TOKEN is optional.
JIRA_TOKEN=
GITLAB_TOKEN=
GITHUB_TOKEN=
