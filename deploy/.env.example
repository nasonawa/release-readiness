# Copy to deploy/.env. Parsed as data, not shell: no variable expansion.
NAMESPACE=nasonawa
# Current v2 release. Rebuild this tag from current code before deployment.
IMAGE=quay.io/nasonawa/release-readness:v2.2
# Optional: blank lets OpenShift choose the route and default storage class.
ROUTE_HOST=
STORAGE_CLASS=
STORAGE_SIZE=5Gi
# Self-contained, minified KONFLUX reader kubeconfig, not the OCP target config.
# Relative paths are resolved against this .env file.
KONFLUX_KUBECONFIG=
# Optional Docker/Podman auth JSON for a private image repository.
IMAGE_PULL_SECRET_FILE=

JIRA_EMAIL=
# Supply either a token inline or a file containing only that token.
JIRA_TOKEN=
JIRA_TOKEN_FILE=
GITLAB_TOKEN=
GITLAB_TOKEN_FILE=
GITHUB_TOKEN=
GITHUB_TOKEN_FILE=

# All keys in deploy/base/app.env may be overridden here. Defaults are documented
# there; blank URL disables an optional source. Examples:
# JIRA_API_URL=https://api.atlassian.com/ex/jira/YOUR-CLOUD-ID
# KONFLUX_NAMESPACE=art-quay-tenant
# ART_GROUPS=quay-3.18,quay-5.0
# CI_WORKERS=4
# PROW_HISTORY_INTERVAL=1h
# GITLAB_URL=
